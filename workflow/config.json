{
  "atom_debug": false,
  "enabled": true,
  "stop_gate_max_blocks": 2,
  "min_files_to_block": 2,
  "remind_after_turns": 3,
  "max_reminders": 3,
  "stale_threshold_hours": 24,
  "dashboard_port": 3848,
  "sync_keywords": [
    "同步",
    "sync",
    "commit",
    "提交",
    "結束",
    "收工"
  ],
  "completion_indicators": [
    "已同步",
    "同步完成",
    "已更新",
    "已提交",
    "committed"
  ],
  "vector_search": {
    "enabled": true,
    "service_port": 3849,
    "embedding_backend": "ollama",
    "embedding_model": "qwen3-embedding",
    "fallback_backend": "sentence-transformers",
    "fallback_model": "BAAI/bge-m3",
    "ollama_base_url": "http://127.0.0.1:11434",
    "ollama_llm_model": "qwen3:1.7b",
    "ollama_backends": {
      "rdchat-direct": {
        "base_url": "http://192.168.199.130:11434",
        "llm_model": "gemma4:e4b",
        "embedding_model": "qwen3-embedding:latest",
        "priority": 1,
        "enabled": true,
        "think": true,
        "llm_num_predict": 4096
      },
      "local": {
        "base_url": "http://127.0.0.1:11434",
        "llm_model": "qwen3:1.7b",
        "embedding_model": "qwen3-embedding",
        "priority": 3,
        "think": false,
        "llm_num_predict": 2048
      }
    },
    "search_top_k": 5,
    "search_min_score": 0.65,
    "search_timeout_ms": 3500,
    "auto_start_service": true,
    "auto_index_on_change": true,
    "global_layer": "bm25",
    "bm25_min_score": 1.0,
    "bm25_top_k": 3
  },
  "write_gate": {
    "enabled": true,
    "auto_threshold": 0.5,
    "ask_threshold": 0.3,
    "dedup_score": 0.8,
    "skip_on_explicit_user": true
  },
  "episodic": {
    "auto_generate": true,
    "min_files": 1,
    "min_duration_seconds": 120
  },
  "_unused_cleanup": "cleanup/session_awareness/decay 設定僅供 memory-audit.py --enforce 使用，guardian 不讀取",
  "cross_session": {
    "enabled": true,
    "min_score": 0.75,
    "promote_threshold": 2,
    "suggest_threshold": 4,
    "timeout_seconds": 5
  },
  "self_iteration": {
    "decay_half_life_days": 30,
    "promote_confirmations_threshold": 4,
    "promote_min_confirmations": 20,
    "archive_score_threshold": 0.3,
    "oscillation_window": 3,
    "oscillation_threshold": 2,
    "review_interval": 6
  },
  "usefulness": {
    "_doc": "Phase 2 (#2) 注入→使用→結果 閉環效用：Beta-Bernoulli (α,β) + Wilson 下界 + 慢衰減。py↔js 鏡像門檻 (promote_lb/min_n/wilson_z) 與 lib/atom_access.py、server.js SYNC。",
    "enabled": true,
    "lexical_overlap_min": 0.18,
    "rare_token_min": 2,
    "wilson_z": 1.96,
    "promote_lb": 0.6,
    "demote_lb": 0.35,
    "min_n": 3,
    "decay_lambda": 0.97,
    "embedding_tiebreak": true,
    "embed_timeout_s": 1.5
  },
  "hot_cache": {
    "enabled": true,
    "quick_extract_timeout": 15,
    "quick_extract_num_predict": 512,
    "quick_extract_min_chars": 100,
    "max_summary_tokens": 100,
    "deep_overwrite": true
  },
  "response_capture": {
    "enabled": true,
    "session_end_max_chars": 20000,
    "session_end_max_items": 5,
    "session_end_timeout_seconds": 10,
    "classification_default": "[臨]",
    "per_turn": {
      "enabled": true,
      "min_new_chars": 500,
      "max_items": 3,
      "skip_cross_session": true,
      "cooldown_seconds": 120
    },
    "failure_extraction": {
      "enabled": true,
      "cooldown_seconds": 180,
      "max_items": 2,
      "strong_keywords": ["又錯了", "沒修好", "還是壞", "修復失敗", "一樣的問題", "又壞了", "怎麼又", "再次失敗"],
      "weak_keywords": ["錯了", "不對", "壞了", "失敗", "沒用", "沒效", "不行", "bug", "broken", "failed", "still broken", "same error", "為什麼還", "怎麼還", "反覆", "踩坑", "又踩", "沒生效", "白做了"],
      "weak_min_match": 3
    }
  },
  "userExtraction": {
    "enabled": true,
    "mode": "production",
    "tokenBudget": 240
  },
  "parallel_agents": {
    "enabled": true,
    "min_score": 2,
    "cooldown_turns": 3,
    "min_prompt_chars": 15
  },
  "changelog_auto_roll": {
    "enabled": true,
    "threshold": 8
  },
  "codex_companion": {
    "enabled": true,
    "codex_binary": "C:/Users/holylight/AppData/Roaming/npm/codex.cmd",
    "model": "",
    "assessment_timeout": 60,
    "subprocess_timeout": 90,
    "score_threshold": 7,
    "max_audits_per_session": 30,
    "silent_advisory": true,
    "max_inject_severity": "high",
    "soft_gate": {
      "completion_evidence": true,
      "architecture_review": false,
      "block_severity_threshold": "high"
    },
    "block_template": "Codex Companion 軟閘：偵測到高風險缺漏。\n{detail}\n請補充驗證或修正後再收尾。"
  },
  "docdrift": {
    "enabled": true,
    "path_mappings": {
      "hooks/wg_*.py": ["Architecture.md"],
      "hooks/dispatcher.py": ["Architecture.md"],
      "hooks/handlers/*.py": ["Architecture.md"],
      "hooks/workflow-guardian.py": ["Architecture.md"],
      "hooks/extract-worker.py": ["Architecture.md"],
      "hooks/quick-extract.py": ["Architecture.md"],
      "hooks/wisdom_engine.py": ["Architecture.md"],
      "skills/*/SKILL.md": ["DocIndex-System.md"],
      "rules/*.md": ["DocIndex-System.md"],
      "tools/*.py": ["DocIndex-System.md"]
    },
    "exclude_patterns": [
      "_aidocs/", "memory/", "_staging/", ".git/",
      "node_modules/", "__pycache__/", ".claude/workflow/",
      "backups/", "debug/", "Logs/"
    ],
    "keyword_match_threshold": 2,
    "max_pending_display": 5
  },
  "heal": {
    "enabled": true,
    "backend": "ollama",
    "max_concurrent": 1,
    "agent_timeout_ms": 180000,
    "run_full_verify": false,
    "_comment": "記憶自癒(腦內世界 P3)：backend=ollama 本地免費序列；改 cloud + max_concurrent>1 可雲端並行(需接 adapter)"
  },
  "realm": {
    "auto_migrate": true,
    "llm_fallback": {
      "enabled": true,
      "backend": "ollama",
      "max_per_session": 5,
      "min_confidence": 0.7,
      "_comment": "SessionEnd sweep 對詞庫 miss 的 unknown-core atom 喚本地 LLM 判 realm+階層 domain。基礎設施失敗→defer 留原地(不誤降級)；unsure/低信心→Else；local≥min_confidence→搬+學詞。protected 永不喚 LLM。enabled=false 則只跑 deterministic 詞庫(含 learned)。"
    }
  },
  "world_dev": {
    "_doc": "腦內世界環境演化引擎旋鈕（宣告鏡像）。引擎在前端 world.html(ENGINE 常數)為運行時源，純前端免重啟；mode 經 world-dev.json 持久、?fast=1 / 指令台 worlddev 覆寫。改此處需同步 world.html ENGINE。",
    "mode": "slow",
    "direction_gate": 35,
    "consensus_min": 3,
    "style2_unlock": 60,
    "done_at": 80,
    "modes": {
      "slow": { "env_chance": 0.01, "pair_chance": 0.05, "dev_step": 1.2 },
      "fast": { "env_chance": 0.55, "pair_chance": 0.75, "dev_step": 6.0 }
    }
  },
  "auto_handoff": {
    "_doc": "Auto-Handoff 自動無損交接（plans/wise-wobbling-gem.md）。PreCompact 壓縮前自動備六區塊 stub 到 _staging（核心保底，不依賴 token 量測）；PostToolBatch 壓縮後注入提示叫模型補全主觀區塊。token_warn 系列為 Phase 2 Stop 預警旗標。enabled=false 一鍵全關回現狀。",
    "enabled": true,
    "precompact_stub": true,
    "postbatch_emit": true,
    "token_warn": true,
    "token_warn_ratio": 0.85,
    "context_window_tokens": 200000,
    "context_base_overhead_tokens": 15000,
    "sessionend_fallback": true,
    "stub_filename": "next-phase-auto.md"
  }
}