{
  "_doc": "verify 用 fixture 詞表（forbidden-phrases.json 新三段的樣板；內容＝hooks/wg_evasion.py 的 _FALLBACK_*；正式詞表由總控台加）。",
  "fixed_claim": {
    "_doc": "說「修好」→ Stop 對帳閘要本回合對得上改檔的 PASS 收據（exit 0 或無 exit）。exclude：否定／疑問／未來式／英文否定。",
    "patterns": [
      "修好",
      "已修復",
      "修復(?:完成|了|好)",
      "修正(?:完成|了|好)",
      "已修正",
      "修掉了",
      "補好了",
      "\\bfixed\\b"
    ],
    "exclude_patterns": {
      "patterns": [
        "(?:還沒|還未|尚未|沒有?|未|無法|不能|不會|不算|不是|沒能)[^，。！？\\n]{0,6}(?:修好|修復|修正|修掉|補好)",
        "(?:修好|修復|修正)[^，。！？\\n]{0,4}(?:之前|前|嗎|沒|了沒)",
        "(?:要|該|怎麼|如何|待|請|先|再|去)\\s*(?:修好|修復|修正)",
        "\\bnot\\b",
        "\\bisn't\\b",
        "\\bhasn't\\b",
        "\\bwasn't\\b",
        "\\bnever\\b",
        "\\bunfixed\\b",
        "[?？]\\s*$",
        "嗎"
      ]
    }
  },
  "measured_claim": {
    "_doc": "說「量了」→ 要本回合 DONE 收據。",
    "patterns": [
      "量了",
      "量過",
      "量測(?:完|過|了|完成)",
      "已量",
      "量尺(?:跑|量)(?:過|了)",
      "實測(?:了|過|結果|數據)",
      "\\bmeasured\\b",
      "\\bbenchmark(?:ed)?\\b"
    ],
    "exclude_patterns": {
      "patterns": [
        "(?:還沒|還未|尚未|沒有?|未|無法|不能|沒能)[^，。！？\\n]{0,6}(?:量|測)",
        "(?:要|該|再|先|請|去|會)\\s*(?:量|實測)",
        "\\bnot\\b",
        "\\bisn't\\b",
        "\\bhasn't\\b",
        "\\bwasn't\\b",
        "\\bnever\\b",
        "\\bunfixed\\b",
        "[?？]\\s*$",
        "嗎"
      ]
    }
  },
  "tried_claim": {
    "_doc": "說「試過／跑了」→ 本回合要有 Bash／PowerShell 呼叫或帳本收據。",
    "patterns": [
      "【試過】",
      "試過",
      "試了",
      "試跑(?:了|過)?",
      "跑(?:了|過)",
      "執行(?:了|過)",
      "實跑(?:了|過)",
      "\\btried\\b",
      "\\bran\\s+(?:it|the|them)\\b"
    ],
    "exclude_patterns": {
      "patterns": [
        "(?:還沒|還未|尚未|沒有?|未|不曾|無法|不能|沒能)[^，。！？\\n]{0,4}(?:試|跑|執行)",
        "(?:試|跑|執行)[^，。！？\\n]{0,3}(?:之前|前|看看|嗎|了沒)",
        "(?:要|該|再|先|會|請|建議|去)\\s*(?:試|跑|執行)",
        "\\bnot\\b",
        "\\bisn't\\b",
        "\\bhasn't\\b",
        "\\bwasn't\\b",
        "\\bnever\\b",
        "\\bunfixed\\b",
        "[?？]\\s*$",
        "嗎"
      ]
    }
  }
}
